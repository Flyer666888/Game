# Visual Studio cache
.vs/
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# Solution/project files generated by the engine
*.sln
*.xcodeproj
*.xcworkspace

# Compiled binaries
Binaries/
Build/
Plugins/*/Binaries/

# Engine-generated intermediates (regenerable)
Intermediate/
Plugins/*/Intermediate/

# Editor caches and autosaves (regenerable)
Saved/
DerivedDataCache/

# Built lighting data (regenerable via Build Lighting; files can exceed GitHub's 100MB limit)
**/*_BuiltData.uasset

# Logs / junk
*.log
Desktop.ini
Thumbs.db
